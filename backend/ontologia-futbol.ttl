@prefix : <http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol/> .

<http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#albergaPartido
:albergaPartido rdf:type owl:ObjectProperty ;
                owl:inverseOf :seJuegaEn ;
                rdfs:domain :Estadio ;
                rdfs:range :Partido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#anotaGol
:anotaGol rdf:type owl:ObjectProperty ;
          owl:inverseOf :goleador ;
          rdfs:domain :Jugador ;
          rdfs:range :Gol .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#arbitra
:arbitra rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :Arbitro ;
         rdfs:range :Partido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#asisteGol
:asisteGol rdf:type owl:ObjectProperty ;
           owl:inverseOf :asistencia ;
           rdfs:domain :Jugador ;
           rdfs:range :Gol .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#asistencia
:asistencia rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Gol ;
            rdfs:range :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#correspondeA
:correspondeA rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              owl:inverseOf :tienePartido ;
              rdfs:domain :Partido ;
              rdfs:range :Temporada .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#dirige
:dirige rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf owl:topObjectProperty ;
        rdfs:domain :Entrenador ;
        rdfs:range :Equipo .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#entraEn
:entraEn rdf:type owl:ObjectProperty ;
         owl:inverseOf :jugadorEntra ;
         rdfs:domain :Jugador ;
         rdfs:range :Sustitucion .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esArbitradoPor
:esArbitradoPor rdf:type owl:ObjectProperty ;
                rdfs:domain :Partido ;
                rdfs:range :Arbitro .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esDirigidoPor
:esDirigidoPor rdf:type owl:ObjectProperty ;
               rdfs:domain :Equipo ;
               rdfs:range :Entrenador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esLocalEn
:esLocalEn rdf:type owl:ObjectProperty ;
           owl:inverseOf :tieneEquipoLocal ;
           rdfs:domain :Equipo ;
           rdfs:range :Partido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esParteDe
:esParteDe rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Partido ;
           rdfs:range :Temporada .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esRecibidaPor
:esRecibidaPor rdf:type owl:ObjectProperty ;
               owl:inverseOf :recibeTarjeta ;
               rdfs:domain :Jugador ;
               rdfs:range :Tarjeta .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esSedeDe
:esSedeDe rdf:type owl:ObjectProperty ;
          owl:inverseOf :tieneEstadio ;
          rdfs:domain :Estadio ;
          rdfs:range :Equipo .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esVisitanteEn
:esVisitanteEn rdf:type owl:ObjectProperty ;
               owl:inverseOf :tieneEquipoVisitante ;
               rdfs:domain :Equipo ;
               rdfs:range :Partido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#goleador
:goleador rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain :Gol ;
          rdfs:range :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#juegaEn
:juegaEn rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         owl:inverseOf :tieneJugador ;
         rdf:type owl:FunctionalProperty ;
         rdfs:domain :Jugador ;
         rdfs:range :Equipo .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#jugadorEntra
:jugadorEntra rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdf:type owl:FunctionalProperty ;
              rdfs:domain :Sustitucion ;
              rdfs:range :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#jugadorSale
:jugadorSale rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             owl:inverseOf :saleDe ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :Sustitucion ;
             rdfs:range :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#perteneceA
:perteneceA rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Equipo ;
            rdfs:range :Competicion .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#recibeTarjeta
:recibeTarjeta rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Tarjeta ;
               rdfs:range :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#resultadoDe
:resultadoDe rdf:type owl:ObjectProperty ;
             owl:inverseOf :tieneResultado ;
             rdfs:domain :Resultado ;
             rdfs:range :Partido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#saleDe
:saleDe rdf:type owl:ObjectProperty ;
        rdfs:domain :Jugador ;
        rdfs:range :Sustitucion .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#seJuegaEn
:seJuegaEn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Partido ;
           rdfs:range :Estadio .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneEquipo
:tieneEquipo rdf:type owl:ObjectProperty ;
             rdfs:domain :Competicion ;
             rdfs:range :Equipo .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneEquipoLocal
:tieneEquipoLocal rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Partido ;
                  rdfs:range :Equipo .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneEquipoVisitante
:tieneEquipoVisitante rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain :Partido ;
                      rdfs:range :Equipo .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneEstadio
:tieneEstadio rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Equipo ;
              rdfs:range :Estadio .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneEvento
:tieneEvento rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Partido ;
             rdfs:range :EventoPartido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneJugador
:tieneJugador rdf:type owl:ObjectProperty ;
              rdfs:domain :Equipo ;
              rdfs:range :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tienePartido
:tienePartido rdf:type owl:ObjectProperty ;
              rdfs:domain :Temporada ;
              rdfs:range :Partido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneResultado
:tieneResultado rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :Partido ;
                rdfs:range :Resultado .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneTemporada
:tieneTemporada rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :Competicion ;
                rdfs:range :Temporada .


###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdfs:domain :Resultado ;
                      rdfs:range :Partido .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esCapitan
:esCapitan rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :Jugador ;
           rdfs:range xsd:boolean .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#esTitular
:esTitular rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :Jugador ;
           rdfs:range xsd:boolean .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#motivoTarjeta
:motivoTarjeta rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :Tarjeta ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneAñoFin
:tieneAñoFin rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Temporada ;
             rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneAñoInicio
:tieneAñoInicio rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain :Temporada ;
                rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneCapacidad
:tieneCapacidad rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain :Estadio ;
                rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneCiudad
:tieneCiudad rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Equipo ,
                         :Estadio ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneDorsal
:tieneDorsal rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Jugador ;
             rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneFecha
:tieneFecha rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Partido ;
            rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneFechaNacimiento
:tieneFechaNacimiento rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain :Persona ;
                      rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneGolesLocal
:tieneGolesLocal rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain :Resultado ;
                 rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneGolesVisitante
:tieneGolesVisitante rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Resultado ;
                     rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneJornada
:tieneJornada rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :Partido ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneMinuto
:tieneMinuto rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :EventoPartido ;
             rdfs:range xsd:integer .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneNacionalidad
:tieneNacionalidad rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain :Equipo ,
                               :Persona ;
                   rdfs:range xsd:string .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneNombre
:tieneNombre rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Competicion ,
                         :Equipo ,
                         :Estadio ,
                         :Persona ;
             rdfs:range xsd:string .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tienePais
:tienePais rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :Equipo ,
                       :Estadio ;
           rdfs:range xsd:string .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tienePosicion
:tienePosicion rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :Jugador ;
               rdfs:range xsd:string .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#tieneTiempo
:tieneTiempo rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :EventoPartido ;
             rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Arbitro
:Arbitro rdf:type owl:Class ;
         rdfs:subClassOf :Persona ;
         owl:disjointWith :Entrenador ,
                          :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Clasificatoria
:Clasificatoria rdf:type owl:Class ;
                rdfs:subClassOf :Competicion ;
                owl:disjointWith :Copa ,
                                 :Liga ,
                                 :Supercopa ,
                                 :TorneoAmistoso ,
                                 :TorneoInternacional .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Competicion
:Competicion rdf:type owl:Class .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Copa
:Copa rdf:type owl:Class ;
      rdfs:subClassOf :Competicion ;
      owl:disjointWith :Liga ,
                       :Supercopa ,
                       :TorneoAmistoso ,
                       :TorneoInternacional .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Entrenador
:Entrenador rdf:type owl:Class ;
            rdfs:subClassOf :Persona ;
            owl:disjointWith :Jugador .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Equipo
:Equipo rdf:type owl:Class .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Estadio
:Estadio rdf:type owl:Class .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#EventoPartido
:EventoPartido rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :esParteDe ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :Partido
                               ] .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Gol
:Gol rdf:type owl:Class ;
     rdfs:subClassOf :EventoPartido ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :goleador ;
                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Jugador
                     ] ;
     owl:disjointWith :Sustitucion ,
                      :Tarjeta .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#GolDeJuegoAbierto
:GolDeJuegoAbierto rdf:type owl:Class ;
                   rdfs:subClassOf :Gol ;
                   owl:disjointWith :GolDePenal ,
                                    :GolEnPropiaPorteria .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#GolDePenal
:GolDePenal rdf:type owl:Class ;
            rdfs:subClassOf :Gol ;
            owl:disjointWith :GolEnPropiaPorteria .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#GolEnPropiaPorteria
:GolEnPropiaPorteria rdf:type owl:Class ;
                     rdfs:subClassOf :Gol .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Jugador
:Jugador rdf:type owl:Class ;
         rdfs:subClassOf :Persona ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :juegaEn ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Equipo
                         ] .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Liga
:Liga rdf:type owl:Class ;
      rdfs:subClassOf :Competicion ;
      owl:disjointWith :Supercopa ,
                       :TorneoAmistoso ,
                       :TorneoInternacional .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Partido
:Partido rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :tieneEquipoLocal ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Equipo
                         ] .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Persona
:Persona rdf:type owl:Class .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Resultado
:Resultado rdf:type owl:Class .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Supercopa
:Supercopa rdf:type owl:Class ;
           rdfs:subClassOf :Competicion ;
           owl:disjointWith :TorneoAmistoso ,
                            :TorneoInternacional .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Sustitucion
:Sustitucion rdf:type owl:Class ;
             rdfs:subClassOf :EventoPartido ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :jugadorEntra ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Jugador
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :jugadorSale ;
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Jugador
                             ] ;
             owl:disjointWith :Tarjeta .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Tarjeta
:Tarjeta rdf:type owl:Class ;
         rdfs:subClassOf :EventoPartido .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#TarjetaAmarilla
:TarjetaAmarilla rdf:type owl:Class ;
                 rdfs:subClassOf :Tarjeta ;
                 owl:disjointWith :TarjetaRoja .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#TarjetaRoja
:TarjetaRoja rdf:type owl:Class ;
             rdfs:subClassOf :Tarjeta .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#Temporada
:Temporada rdf:type owl:Class .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#TorneoAmistoso
:TorneoAmistoso rdf:type owl:Class ;
                rdfs:subClassOf :Competicion ;
                owl:disjointWith :TorneoInternacional .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#TorneoInternacional
:TorneoInternacional rdf:type owl:Class ;
                     rdfs:subClassOf :Competicion .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#arbitro_01
:arbitro_01 rdf:type owl:NamedIndividual ,
                     :Arbitro ;
            :tieneFechaNacimiento "1977-01-01T00:00:00"^^xsd:dateTime ;
            :tieneNacionalidad "Española" ;
            :tieneNombre "Antonio Mateu Lahoz" .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#arbitro_02
:arbitro_02 rdf:type owl:NamedIndividual ,
                     :Arbitro ;
            :tieneFechaNacimiento "1981-06-05T00:00:00"^^xsd:dateTime ;
            :tieneNacionalidad "Alemana" ;
            :tieneNombre "Felix Zwayer" .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#arbitro_03
:arbitro_03 rdf:type owl:NamedIndividual ,
                     :Arbitro ;
            :tieneFechaNacimiento "1982-03-12T00:00:00"^^xsd:dateTime ;
            :tieneNacionalidad "Francesa" ;
            :tieneNombre "Clément Turpin" .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#arbitro_04
:arbitro_04 rdf:type owl:NamedIndividual ,
                     :Arbitro ;
            :tieneFechaNacimiento "1975-12-10T00:00:00"^^xsd:dateTime ;
            :tieneNacionalidad "Italiana" ;
            :tieneNombre "Daniele Orsato" .


###  http://www.semanticweb.org/valer/ontologies/2026/2/ontologia_futbol#arbitro_05
:arbitro_05 rdf:type owl:NamedIndividual ,
                     :Arbitro ;
            :tieneFechaNacimiento "1980-04-22T00:00:00"^^xsd:dateTime ;
            :tieneNacionalidad "Colombiana" ;
